	column 'Time Band Sort'
		dataType: int64
		isHidden
		lineageTag: 3c72b5b7-dabc-59ac-973f-6e6f78156e0b
		summarizeBy: none
		sourceColumn: Time Band Sort

		annotation SummarizationSetBy = User

