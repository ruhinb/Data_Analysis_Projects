	/// Sorts Age Band.
	column 'Age Band Sort'
		dataType: int64
		isHidden
		lineageTag: 942b0cae-7c2a-5577-860e-e0872ad7a8fe
		summarizeBy: none
		sourceColumn: Age Band Sort

		annotation SummarizationSetBy = User

	/// Whether the appointment is in the pilot target segment (semi-urban patient, morning slot).
	column 'Target Segment'
		dataType: string
		lineageTag: 6e58065f-14dc-5e8d-880b-fe7b8e10218b
		summarizeBy: none
		sourceColumn: Target Segment

		annotation SummarizationSetBy = User

	/// Overall result of the reminders for this appointment: Delivered, Failed, Pending or unknown, or No reminder record.
	column 'Reminder Outcome'
		dataType: string
		lineageTag: dd92272f-5b68-5114-a098-d18a636078b2
		summarizeBy: none
		sourceColumn: Reminder Outcome

		annotation SummarizationSetBy = User

	/// Short form of Time Band for chart axes: Early AM, Late AM, Midday, Afternoon, Evening.
	column 'Time of Day'
		dataType: string
		lineageTag: 1473a683-558f-5c1c-a8d3-cd2f83fb6f5f
		summarizeBy: none
		sourceColumn: Time of Day
		sortByColumn: 'Time Band Sort'

		annotation SummarizationSetBy = User

	partition Appointments = m
		mode: import
		queryGroup: Facts
		source =
				let
				    Source = fnLoadTable("fact_appointments", {"appointment_key", "patient_key", "clinic_key", "doctor_key", "scheduled_date_key", "specialty", "appointment_status", "booking_channel", "consultation_mode", "visit_type", "priority_level", "referral_source", "cancellation_reason", "is_follow_up", "scheduled_start_valid", "has_data_quality_issue", "lead_time_days", "lead_time_band", "lead_time_band_sort", "scheduled_time_band", "scheduled_time_band_sort", "patient_age_at_appointment", "patient_age_band", "patient_age_band_sort", "pilot_target_segment", "reminder_delivery_group"}, {"is_follow_up", "scheduled_start_valid", "has_data_quality_issue"}),
				    TypedColumns = Table.TransformColumnTypes(Source, {{"appointment_key", Int64.Type}, {"patient_key", Int64.Type}, {"clinic_key", Int64.Type}, {"doctor_key", Int64.Type}, {"scheduled_date_key", Int64.Type}, {"specialty", type text}, {"appointment_status", type text}, {"booking_channel", type text}, {"consultation_mode", type text}, {"visit_type", type text}, {"priority_level", type text}, {"referral_source", type text}, {"cancellation_reason", type text}, {"lead_time_days", Int64.Type}, {"lead_time_band", type text}, {"lead_time_band_sort", Int64.Type}, {"scheduled_time_band", type text}, {"scheduled_time_band_sort", Int64.Type}, {"patient_age_at_appointment", Int64.Type}, {"patient_age_band", type text}, {"patient_age_band_sort", Int64.Type}, {"pilot_target_segment", type text}, {"reminder_delivery_group", type text}}, "en-US"),
				    FilledSpecialty = Table.TransformColumns(TypedColumns, {{"specialty", each if _ = null or _ = "" then "Not recorded" else _, type text}}),
				    RenamedColumns = Table.RenameColumns(FilledSpecialty, {{"appointment_key", "Appointment Key"}, {"patient_key", "Patient Key"}, {"clinic_key", "Clinic Key"}, {"doctor_key", "Doctor Key"}, {"scheduled_date_key", "Scheduled Date Key"}, {"specialty", "Specialty"}, {"appointment_status", "Appointment Status"}, {"booking_channel", "Booking Channel"}, {"consultation_mode", "Consultation Mode"}, {"visit_type", "Visit Type"}, {"priority_level", "Priority"}, {"referral_source", "Referral Source"}, {"cancellation_reason", "Cancellation Reason"}, {"is_follow_up", "Is Follow-up"}, {"scheduled_start_valid", "Has Valid Scheduled Date"}, {"has_data_quality_issue", "Has Data Quality Issue"}, {"lead_time_days", "Lead Time (days)"}, {"lead_time_band", "Lead Time Band"}, {"lead_time_band_sort", "Lead Time Band Sort"}, {"scheduled_time_band", "Time Band"}, {"scheduled_time_band_sort", "Time Band Sort"}, {"patient_age_at_appointment", "Patient Age"}, {"patient_age_band", "Age Band"}, {"patient_age_band_sort", "Age Band Sort"}, {"pilot_target_segment", "Target Segment"}, {"reminder_delivery_group", "Reminder Outcome"}}),
				    AddedTimeofDay = Table.AddColumn(RenamedColumns, "Time of Day", each if [Time Band] = "Early morning (before 10:00)" then "Early AM" else if [Time Band] = "Late morning (10:00-11:59)" then "Late AM" else if [Time Band] = "Early afternoon (12:00-13:59)" then "Midday" else if [Time Band] = "Late afternoon (14:00-16:59)" then "Afternoon" else if [Time Band] = "Evening (17:00+)" then "Evening" else "Unknown", type text)
				in
				    AddedTimeofDay

	annotation PBI_ResultType = Table

