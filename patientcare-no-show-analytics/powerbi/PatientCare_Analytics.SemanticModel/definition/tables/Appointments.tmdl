		lineageTag: ada618a5-aa12-58ca-9649-887afce9bba8
		summarizeBy: none
		sourceColumn: Lead Time Band
		sortByColumn: 'Lead Time Band Sort'

		annotation SummarizationSetBy = User

	/// Sorts Lead Time Band.
	column 'Lead Time Band Sort'
		dataType: int64
		isHidden
		lineageTag: 9a3f00e2-a965-5083-8fa4-31ad3d82de95
