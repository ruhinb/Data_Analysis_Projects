		lineageTag: 4e8d6fc4-e39f-50ec-b768-c9435ccbf418
		summarizeBy: none
		sourceColumn: Referral Source

		annotation SummarizationSetBy = User

	/// Reason given when the appointment was cancelled.
	column 'Cancellation Reason'
		dataType: string
		lineageTag: d2f87021-6da2-50c2-a970-abe18dc1e3ed
		summarizeBy: none
		sourceColumn: Cancellation Reason

		annotation SummarizationSetBy = User

	/// Yes when the visit follows an earlier appointment.
	column 'Is Follow-up'
		dataType: string
		lineageTag: 1d64eedf-b40b-531a-866b-8f2692a19bdb
		summarizeBy: none
		sourceColumn: Is Follow-up

		annotation SummarizationSetBy = User

	/// No for the 23 appointments whose scheduled date could not be read. Measures count valid appointments only.
