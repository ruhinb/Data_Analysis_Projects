		dataType: int64
		formatString: 0
		lineageTag: 29010cc5-0b7e-5831-8197-2ed244332385
		summarizeBy: none
		sourceColumn: Patient Age

		annotation SummarizationSetBy = User

	/// Patient age grouped into bands.
	column 'Age Band'
		dataType: string
		lineageTag: 3a198d3e-b505-573d-bed9-0bcd5320bb5b
		summarizeBy: none
		sourceColumn: Age Band
		sortByColumn: 'Age Band Sort'

