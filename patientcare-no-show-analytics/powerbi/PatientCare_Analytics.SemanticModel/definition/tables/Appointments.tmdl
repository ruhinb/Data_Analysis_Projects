		lineageTag: 1b17adee-6ebb-5d30-bb56-6ff52e222600
		summarizeBy: none
		sourceColumn: Specialty

		annotation SummarizationSetBy = User

	/// Final status: Completed, No-show, Cancelled, Rescheduled or Status review required.
	column 'Appointment Status'
		dataType: string
		lineageTag: 763a5ec3-4e1d-506a-b5ff-058645a4fbca
		summarizeBy: none
		sourceColumn: Appointment Status

		annotation SummarizationSetBy = User

	/// How the appointment was booked, for example app or walk-in.
	column 'Booking Channel'
		dataType: string
		lineageTag: 8378e3ff-4e00-5bfc-82cf-ba533f3697c7
		summarizeBy: none
		sourceColumn: Booking Channel

		annotation SummarizationSetBy = User

	/// In person or telemedicine.
	column 'Consultation Mode'
		dataType: string
		lineageTag: c2790641-c678-530b-a4f6-16c0eaf96d27
		summarizeBy: none
		sourceColumn: Consultation Mode

		annotation SummarizationSetBy = User

	/// Visit type, for example New consultation or Follow-up.
	column 'Visit Type'
		dataType: string
		lineageTag: dc3a828e-3e29-555b-af0e-98aea756d80e
		summarizeBy: none
		sourceColumn: Visit Type

		annotation SummarizationSetBy = User

	/// Booking priority: Routine, Priority or Urgent.
	column Priority
		dataType: string
		lineageTag: 64994e80-c7a1-5f6c-9d13-78193ec4dff1
		summarizeBy: none
		sourceColumn: Priority

