	partition Patient = m
		mode: import
		queryGroup: Dimensions
		source =
				let
				    Source = fnLoadTable("dim_patient", {"patient_key", "gender", "division", "district", "urban_rural", "preferred_language", "sms_opt_in", "whatsapp_opt_in", "chronic_condition_segment", "patient_status"}, {"sms_opt_in", "whatsapp_opt_in"}),
				    TypedColumns = Table.TransformColumnTypes(Source, {{"patient_key", Int64.Type}, {"gender", type text}, {"division", type text}, {"district", type text}, {"urban_rural", type text}, {"preferred_language", type text}, {"chronic_condition_segment", type text}, {"patient_status", type text}}, "en-US"),
				    RenamedColumns = Table.RenameColumns(TypedColumns, {{"patient_key", "Patient Key"}, {"gender", "Patient Gender"}, {"division", "Patient Division"}, {"district", "Patient District"}, {"urban_rural", "Patient Area"}, {"preferred_language", "Preferred Language"}, {"sms_opt_in", "SMS Opt-in"}, {"whatsapp_opt_in", "WhatsApp Opt-in"}, {"chronic_condition_segment", "Chronic Condition"}, {"patient_status", "Patient Status"}})
				in
