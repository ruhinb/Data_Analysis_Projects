                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Kept = Table.SelectColumns(Promoted, {\"ID\", \"SEGMENT\", \"STATE\", \"REGION\"}),",
                "    Typed = Table.TransformColumnTypes(Kept, {{\"ID\", type text}, {\"SEGMENT\", type text}, {\"STATE\", type text}, {\"REGION\", type text}}),",
                "    Renamed = Table.RenameColumns(Typed, {{\"ID\", \"Customer ID\"}, {\"SEGMENT\", \"Segment\"}, {\"STATE\", \"State\"}, {\"REGION\", \"Region\"}})",
