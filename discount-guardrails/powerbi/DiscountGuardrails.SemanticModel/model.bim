        "lineageTag": "e74abda5-f890-5490-94bf-d58a5a2bcac5",
        "measures": [
          {
            "name": "Sales",
            "description": "Sales after discount",
            "displayFolder": "1 Core",
            "expression": "SUM ( Orders[Sales Amount] )",
            "formatString": "\\$#,0;-\\$#,0;\\$#,0",
            "lineageTag": "88659c2e-82bb-5571-8736-1eb4ff146bed"
          },
          {
            "name": "Profit",
            "description": "Profit as supplied in the data",
            "displayFolder": "1 Core",
            "expression": "SUM ( Orders[Profit Amount] )",
            "formatString": "\\$#,0;-\\$#,0;\\$#,0",
            "lineageTag": "979abe7d-2852-53e2-a675-9df4e78fbb1c"
          },
          {
            "name": "Orders Count",
            "displayFolder": "1 Core",
            "expression": "DISTINCTCOUNT ( Orders[Order ID] )",
            "formatString": "#,0",
            "lineageTag": "cc6689de-3e46-5aac-bae9-1183dc3c7963"
          },
          {
            "name": "Customers Count",
            "displayFolder": "1 Core",
            "expression": "DISTINCTCOUNT ( Orders[Customer ID] )",
            "formatString": "#,0",
            "lineageTag": "08ca20db-4975-5902-a39c-47cb8b456201"
          },
          {
            "name": "Profit per Dollar",
            "description": "Profit margin shown as profit on every $1 sold",
            "displayFolder": "1 Core",
            "expression": "DIVIDE ( [Profit], [Sales] )",
            "formatString": "0.00",
            "lineageTag": "ce842887-dec4-5469-a45c-5a44d1d4acab"
          },
          {
            "name": "Full Price Profit per Dollar",
            "displayFolder": "1 Core",
            "expression": "CALCULATE ( [Profit per Dollar], Orders[Discount] = 0, REMOVEFILTERS ( 'Discount Band' ) )",
            "formatString": "0.00",
            "lineageTag": "e89723eb-fdd2-5847-9bc9-163ab2510599"
          },
          {
            "name": "Same Products Full Price per Dollar",
            "description": "What these same products earn per $1 at full price, weighted by their sales (the mix baseline from SQL Q2)",
            "displayFolder": "1 Core",
            "expression": [
              "VAR SubCats =",
              "    ADDCOLUMNS (",
              "        VALUES ( 'Product'[Sub-category] ),",
              "        \"@Sales\", [Sales],",
              "        \"@Base\", CALCULATE ( [Profit per Dollar], Orders[Discount] = 0, REMOVEFILTERS ( 'Discount Band' ) )",
              "    )",
              "RETURN",
              "    DIVIDE ( SUMX ( SubCats, [@Sales] * [@Base] ), SUMX ( SubCats, [@Sales] ) )"
            ],
            "formatString": "0.00",
            "lineageTag": "9d1e8710-dffb-5b3e-a724-123a5c0ec031"
          },
          {
            "name": "Years Count",
            "displayFolder": "1 Core",
            "expression": "DISTINCTCOUNT ( Orders[Year] )",
            "formatString": "#,0",
            "lineageTag": "31a2890e-b456-5867-ac7d-b810d6ff079a"
          },
          {
            "name": "Heavy Sales",
            "description": "Sales on lines with more than 20% off",
            "displayFolder": "2 Heavy discount",
            "expression": "CALCULATE ( [Sales], Orders[Discount] > 0.2 )",
            "formatString": "\\$#,0;-\\$#,0;\\$#,0",
            "lineageTag": "0c319731-f5f7-5472-8402-3773223eaf04"
          },
          {
            "name": "Heavy Profit",
            "description": "Net profit on lines with more than 20% off",
            "displayFolder": "2 Heavy discount",
            "expression": "CALCULATE ( [Profit], Orders[Discount] > 0.2 )",
            "formatString": "\\$#,0;-\\$#,0;\\$#,0",
            "lineageTag": "74490ff5-4775-5857-9335-081106ff90ae"
          },
          {
            "name": "Heavy Loss",
            "description": "Gross loss on loss-making lines with more than 20% off (positive number)",
            "displayFolder": "2 Heavy discount",
            "expression": "- CALCULATE ( [Profit], Orders[Discount] > 0.2, Orders[Profit Amount] < 0 )",
            "formatString": "\\$#,0;-\\$#,0;\\$#,0",
            "lineageTag": "212df8dc-366e-59d6-8d7c-830b3fed2674"
          },
          {
            "name": "Heavy Customers",
            "displayFolder": "2 Heavy discount",
            "expression": "CALCULATE ( DISTINCTCOUNT ( Orders[Customer ID] ), Orders[Discount] > 0.2 )",
            "formatString": "#,0",
            "lineageTag": "cea29ddc-b36a-5f40-8b79-c0b4bb2a1540"
          },
          {
            "name": "Heavy Orders",
            "displayFolder": "2 Heavy discount",
            "expression": "CALCULATE ( DISTINCTCOUNT ( Orders[Order ID] ), Orders[Discount] > 0.2 )",
            "formatString": "#,0",
            "lineageTag": "2b63250b-9fde-54d3-b4e5-eaa49aaa6fa5"
          },
          {
            "name": "Lines Count",
            "displayFolder": "1 Core",
            "expression": "COUNTROWS ( Orders )",
            "formatString": "#,0",
            "lineageTag": "21120deb-4ad9-5ca7-8fbc-5a0569572369"
          },
          {
            "name": "First Year",
            "displayFolder": "1 Core",
            "expression": "MIN ( Orders[Year] )",
            "formatString": "0",
            "lineageTag": "9a464170-22fa-5c28-8251-54e167752c4b"
          },
          {
            "name": "Last Year",
            "displayFolder": "1 Core",
            "expression": "MAX ( Orders[Year] )",
            "formatString": "0",
            "lineageTag": "b1031913-51ee-52cc-a071-dd5d6185cabe"
          },
          {
            "name": "Heavy Lines",
            "displayFolder": "2 Heavy discount",
            "expression": "CALCULATE ( COUNTROWS ( Orders ), Orders[Discount] > 0.2 )",
            "formatString": "#,0",
            "lineageTag": "f1228e7b-4b43-5d05-ab0a-4397ca4bbc7e"
          },
          {
            "name": "Heavy Loss Lines",
            "displayFolder": "2 Heavy discount",
            "expression": "CALCULATE ( COUNTROWS ( Orders ), Orders[Discount] > 0.2, Orders[Profit Amount] < 0 )",
            "formatString": "#,0",
            "lineageTag": "d7c9a9a1-517c-53e4-b1e7-891df614a713"
          },
          {
            "name": "Years With Heavy Loss",
            "displayFolder": "2 Heavy discount",
            "expression": "COUNTROWS ( FILTER ( VALUES ( Orders[Year] ), [Heavy Profit] < 0 ) )",
            "formatString": "#,0",
            "lineageTag": "6127aa42-699b-5525-a1ab-82ef5ba6d1b5"
          },
          {
            "name": "Kept Share",
            "description": "Share of capped volume customers still buy; defaults to half",
            "displayFolder": "3 Scenario (modelled)",
            "expression": "SELECTEDVALUE ( 'Volume Kept'[Share Kept], 0.5 )",
            "formatString": "0%",
            "lineageTag": "a3c8e84b-b3cb-58e7-ab25-835c1cde68f4"
          },
          {
            "name": "Kept Label",
            "displayFolder": "3 Scenario (modelled)",
            "expression": "SELECTEDVALUE ( 'Volume Kept'[Customers Who Still Buy], \"Half\" )",
            "lineageTag": "e25ecb4a-0962-5ab0-892e-3a80da68ca40"
          },
          {
            "name": "Cap Value",
            "displayFolder": "3 Scenario (modelled)",
            "expression": "SELECTEDVALUE ( 'Max Discount'[Cap], 0.2 )",
            "formatString": "0%",
            "lineageTag": "e4c42363-2dd0-5347-8617-7adfb81f65e2"
          },
          {
            "name": "Profit Change at Cap",
            "description": "MODELLED: profit change if lines above the cap were re-priced at the cap, cost unchanged, with [Share Kept] of the volume kept",
            "displayFolder": "3 Scenario (modelled)",
            "expression": [
              "VAR CapLevel = [Cap Value]",
              "VAR Kept = [Kept Share]",
              "RETURN",
              "    SUMX (",
              "        FILTER ( Orders, Orders[Discount] > CapLevel ),",
              "        Kept * ( Orders[Sales Amount] / ( 1 - Orders[Discount] ) * ( 1 - CapLevel ) - Orders[Implied Cost] ) - Orders[Profit Amount]",
              "    ) + 0"
            ],
            "formatString": "\\$#,0;-\\$#,0;\\$#,0",
            "lineageTag": "3afec2de-83c6-5c5e-8e2f-cd738f85c9e0"
          },
          {
            "name": "Profit Change 20",
            "description": "MODELLED: profit change with a 20% cap",
            "displayFolder": "3 Scenario (modelled)",
            "expression": [
              "VAR Kept = [Kept Share]",
              "RETURN",
              "    SUMX (",
              "        FILTER ( Orders, Orders[Discount] > 0.2 ),",
              "        Kept * ( Orders[Sales Amount] / ( 1 - Orders[Discount] ) * 0.8 - Orders[Implied Cost] ) - Orders[Profit Amount]",
              "    ) + 0"
            ],
            "formatString": "\\$#,0;-\\$#,0;\\$#,0",
            "lineageTag": "d53ac28f-fa82-55bc-95b1-d63dd5987508"
          },
          {
            "name": "Modelled Profit 20",
            "displayFolder": "3 Scenario (modelled)",
            "expression": "[Profit] + [Profit Change 20]",
            "formatString": "\\$#,0;-\\$#,0;\\$#,0",
            "lineageTag": "a59a8130-cd3f-5a70-8974-c1be95f62e6a"
          },
          {
            "name": "Change All Kept",
            "displayFolder": "3 Scenario (modelled)",
            "expression": [
              "SUMX (",
              "    FILTER ( Orders, Orders[Discount] > 0.2 ),",
              "    ( Orders[Sales Amount] / ( 1 - Orders[Discount] ) * 0.8 - Orders[Implied Cost] ) - Orders[Profit Amount]",
              ") + 0"
            ],
            "formatString": "\\$#,0;-\\$#,0;\\$#,0",
            "lineageTag": "8a5df368-db9b-5971-9625-b231cebd3118"
          },
          {
            "name": "Change None Kept",
            "displayFolder": "3 Scenario (modelled)",
            "expression": "- CALCULATE ( [Profit], Orders[Discount] > 0.2 ) + 0",
            "formatString": "\\$#,0;-\\$#,0;\\$#,0",
            "lineageTag": "f918199d-5d5c-5d99-8280-e35f49cd79f0"
          },
          {
            "name": "Change Whole Orders Lost",
            "description": "MODELLED worse case: every order with a capped line is lost entirely",
            "displayFolder": "3 Scenario (modelled)",
            "expression": [
              "VAR AffectedOrders = CALCULATETABLE ( VALUES ( Orders[Order ID] ), Orders[Discount] > 0.2 )",
              "RETURN",
              "    - CALCULATE ( [Profit], TREATAS ( AffectedOrders, Orders[Order ID] ) ) + 0"
            ],
            "formatString": "\\$#,0;-\\$#,0;\\$#,0",
            "lineageTag": "22233967-348d-57d2-b868-a46c4e247344"
          },
          {
            "name": "Latest Quarter Index",
            "displayFolder": "4 Monitor",
            "expression": "CALCULATE ( MAX ( Orders[Quarter Index] ), ALL ( ) )",
            "formatString": "0",
            "lineageTag": "18fc9cef-2786-50ae-a8f4-b0b221fe5a77"
          },
          {
            "name": "Latest Quarter Label",
            "displayFolder": "4 Monitor",
            "expression": [
              "VAR Q = [Latest Quarter Index]",
              "RETURN CALCULATE ( MAX ( Orders[Quarter Label] ), ALL ( ), Orders[Quarter Index] = Q )"
            ],
            "lineageTag": "0541be9f-ef7b-53c4-9235-7a3a61c99261"
          },
          {
            "name": "Previous Quarter Label",
            "displayFolder": "4 Monitor",
            "expression": [
              "VAR Q = [Latest Quarter Index] - 1",
              "RETURN CALCULATE ( MAX ( Orders[Quarter Label] ), ALL ( ), Orders[Quarter Index] = Q )"
            ],
            "lineageTag": "88e4d06d-3598-5158-b7a7-6b4026746678"
          },
          {
            "name": "Latest Q Sales",
            "displayFolder": "4 Monitor",
            "expression": [
              "VAR Q = [Latest Quarter Index]",
              "RETURN CALCULATE ( [Sales], Orders[Quarter Index] = Q )"
            ],
            "formatString": "\\$#,0;-\\$#,0;\\$#,0",
            "lineageTag": "c6761604-fcf1-5c14-9146-7d48b5aa831d"
          },
          {
            "name": "Previous Q Sales",
            "displayFolder": "4 Monitor",
            "expression": [
              "VAR Q = [Latest Quarter Index] - 1",
              "RETURN CALCULATE ( [Sales], Orders[Quarter Index] = Q )"
            ],
            "formatString": "\\$#,0;-\\$#,0;\\$#,0",
            "lineageTag": "85c8a366-dea1-594b-a64e-a745b09085ac"
          },
          {
            "name": "Latest Q Profit",
            "displayFolder": "4 Monitor",
            "expression": [
              "VAR Q = [Latest Quarter Index]",
              "RETURN CALCULATE ( [Profit], Orders[Quarter Index] = Q )"
            ],
            "formatString": "\\$#,0;-\\$#,0;\\$#,0",
            "lineageTag": "2591494c-90ee-577a-b6d2-31a84fe1e395"
          },
          {
            "name": "Previous Q Profit",
            "displayFolder": "4 Monitor",
            "expression": [
              "VAR Q = [Latest Quarter Index] - 1",
              "RETURN CALCULATE ( [Profit], Orders[Quarter Index] = Q )"
            ],
            "formatString": "\\$#,0;-\\$#,0;\\$#,0",
            "lineageTag": "39c0ddb4-9b8c-5072-8f3a-5e6280d9817a"
          },
          {
            "name": "Latest Q Heavy Sales",
            "displayFolder": "4 Monitor",
            "expression": [
              "VAR Q = [Latest Quarter Index]",
              "RETURN CALCULATE ( [Heavy Sales], Orders[Quarter Index] = Q )"
            ],
            "formatString": "\\$#,0;-\\$#,0;\\$#,0",
            "lineageTag": "528c9746-32ac-5760-b9ee-0a6029952618"
          },
          {
            "name": "Previous Q Heavy Sales",
            "displayFolder": "4 Monitor",
            "expression": [
              "VAR Q = [Latest Quarter Index] - 1",
              "RETURN CALCULATE ( [Heavy Sales], Orders[Quarter Index] = Q )"
            ],
            "formatString": "\\$#,0;-\\$#,0;\\$#,0",
            "lineageTag": "efb3a587-1907-5da0-b1e7-2f52165edb91"
          }
        ],
        "partitions": [
          {
            "name": "Orders",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"ORDERS.csv\"), [Columns=12, Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Promoted, {{\"ROW_ID\", Int64.Type}, {\"ORDER_ID\", type text}, {\"ORDER_DATE\", type date}, {\"CUSTOMER_ID\", type text}, {\"PRODUCT_ID\", type text}, {\"SALES\", Currency.Type}, {\"QUANTITY\", Int64.Type}, {\"DISCOUNT\", type number}, {\"PROFIT\", Currency.Type}}, \"en-US\"),",
                "    Kept = Table.SelectColumns(Typed, {\"ROW_ID\", \"ORDER_ID\", \"ORDER_DATE\", \"CUSTOMER_ID\", \"PRODUCT_ID\", \"SALES\", \"QUANTITY\", \"DISCOUNT\", \"PROFIT\"}),",
                "    Renamed = Table.RenameColumns(Kept, {{\"ROW_ID\", \"Row ID\"}, {\"ORDER_ID\", \"Order ID\"}, {\"ORDER_DATE\", \"Order Date\"}, {\"CUSTOMER_ID\", \"Customer ID\"}, {\"PRODUCT_ID\", \"Product ID\"}, {\"SALES\", \"Sales Amount\"}, {\"QUANTITY\", \"Quantity\"}, {\"DISCOUNT\", \"Discount\"}, {\"PROFIT\", \"Profit Amount\"}}),",
                "    // implied cost = sales - profit (the data has no cost field)",
                "    AddCost = Table.AddColumn(Renamed, \"Implied Cost\", each [Sales Amount] - [Profit Amount], Currency.Type),",
                "    // same four bands as dbo.fct_order_line in the SQL project",
                "    AddBand = Table.AddColumn(AddCost, \"Band Key\", each if [Discount] = 0 then 1 else if [Discount] <= 0.2 then 2 else if [Discount] <= 0.5 then 3 else 4, Int64.Type),",
                "    AddYear = Table.AddColumn(AddBand, \"Year\", each Date.Year([Order Date]), Int64.Type),",
                "    AddQuarterIndex = Table.AddColumn(AddYear, \"Quarter Index\", each Date.Year([Order Date]) * 4 + Date.QuarterOfYear([Order Date]) - 1, Int64.Type),",
                "    AddQuarterLabel = Table.AddColumn(AddQuarterIndex, \"Quarter Label\", each {\"Jan–Mar\", \"Apr–Jun\", \"Jul–Sep\", \"Oct–Dec\"}{Date.QuarterOfYear([Order Date]) - 1} & \" \" & Text.From(Date.Year([Order Date])), type text)",
                "in",
                "    AddQuarterLabel"
              ],
              "type": "m"
            }
          }
        ]
      },
