        "partitions": [
          {
            "name": "Product",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"PRODUCT.csv\"), [Columns=4, Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Promoted, {{\"ID\", type text}, {\"NAME\", type text}, {\"CATEGORY\", type text}, {\"SUBCATEGORY\", type text}}),",
                "    // the source column names do not match their contents: NAME = category, CATEGORY = sub-category, SUBCATEGORY = product name",
                "    Renamed = Table.RenameColumns(Typed, {{\"ID\", \"Product ID\"}, {\"NAME\", \"Category\"}, {\"CATEGORY\", \"Sub-category\"}, {\"SUBCATEGORY\", \"Product Name\"}})",
                "in",
                "    Renamed"
              ],
              "type": "m"
            }
