model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Sales","Orders","Staffing","Date","Time Slot","Pizza","Ingredient","Pizza Ingredient","Investigation Date","Trend Metric","Rank By","SalesFilePath","RosterFilePath","AnomalyThreshold","DemandBuffer","PizzasPerCookPerSlot","OrdersPerServerPerSlot","Embedded Sales CSV","Embedded Roster CSV","Raw Sales","Raw Roster","Order Header","Daily Trading","Pizza Staging"]

annotation PBI_ProTooling = ["DevMode"]

ref table Sales
ref table Orders
ref table Staffing
ref table Date
ref table 'Time Slot'
ref table Pizza
ref table Ingredient
ref table 'Pizza Ingredient'
ref table 'Investigation Date'
ref table 'Trend Metric'
ref table 'Rank By'
ref table _Measures

