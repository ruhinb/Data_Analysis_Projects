/// Dimension: continuous calendar for every year in the sales data, with trading-day flags and weekday-adjusted anomaly scores.
table Date
	lineageTag: e5322861-529f-405c-9430-a745efd6eac4
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: dd mmm yyyy
		lineageTag: 551984b2-6d70-417a-af2e-4624dd8e6f4b
		summarizeBy: none
		sourceColumn: Date

		annotation UnderlyingDateTimeDataType = Date

	column Year
		dataType: int64
		formatString: 0
		lineageTag: 5b1471b2-d34c-4844-bdf8-5868a19e5d26
		summarizeBy: none
		sourceColumn: Year

	column Quarter
		dataType: string
		lineageTag: b2395255-010d-4a0c-a68d-95419ada7e3b
		summarizeBy: none
		sourceColumn: Quarter

	column 'Month Number'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: b55971eb-5cdf-455e-825a-8e9b9b04bb04
		summarizeBy: none
		sourceColumn: Month Number

	/// Three-letter month (Jan).
	column Month
		dataType: string
		lineageTag: 0417fa1e-c3e8-486c-b308-73e0f1360656
		summarizeBy: none
		sourceColumn: Month
		sortByColumn: 'Month Number'

	column 'Month Name'
		dataType: string
		lineageTag: 65e08b5f-831a-45e1-bd41-b0cbfae2daef
		summarizeBy: none
		sourceColumn: Month Name
		sortByColumn: 'Month Number'

	column 'Month Year'
		dataType: string
		lineageTag: 5f115c1e-99ca-425b-8c3b-fecebd91ae89
		summarizeBy: none
		sourceColumn: Month Year
		sortByColumn: 'Month Index'

	/// Year x 12 + month; used for period comparisons.
	column 'Month Index'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 562eb15a-8755-4482-adc4-6a8972eccef0
		summarizeBy: none
		sourceColumn: Month Index

	/// Monday of the week.
	column 'Week Start'
		dataType: dateTime
		formatString: dd mmm yyyy
		lineageTag: 2a807e04-f6b1-4f74-ae07-a5b260a14a55
		summarizeBy: none
		sourceColumn: Week Start

		annotation UnderlyingDateTimeDataType = Date

	/// 1 = Monday ... 7 = Sunday.
	column 'Day of Week Number'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 71864297-27a9-4da4-b664-d1a2ec335be2
		summarizeBy: none
		sourceColumn: Day of Week Number

	/// Three-letter weekday (Mon).
	column Weekday
		dataType: string
		lineageTag: f89c8999-2579-4c97-9f18-223b2b175ead
		summarizeBy: none
		sourceColumn: Weekday
		sortByColumn: 'Day of Week Number'

	column 'Weekday Name'
		dataType: string
		lineageTag: 46a94110-ae0a-4069-a0b8-220dc76bfe6d
		summarizeBy: none
		sourceColumn: Weekday Name
		sortByColumn: 'Day of Week Number'

	/// Weekday or Weekend (Saturday, Sunday).
	column 'Day Type'
		dataType: string
		lineageTag: 4369402e-310c-44a0-be6d-b6b70b5bb417
		summarizeBy: none
		sourceColumn: Day Type

	/// Mean revenue of the same weekday, excluding this date (leave-one-out).
	column 'Typical Weekday Revenue'
		dataType: decimal
		isHidden
		formatString: $#,##0
		lineageTag: d75fa0ad-348d-4859-b532-f0bfc2a299cc
		summarizeBy: none
		sourceColumn: Typical Weekday Revenue

	column 'Typical Weekday Orders'
		dataType: double
		isHidden
		formatString: #,##0.0
		lineageTag: 3d492a80-eef6-48b4-ae10-a002aab4a88b
		summarizeBy: none
		sourceColumn: Typical Weekday Orders

	column 'Typical Weekday Pizzas'
		dataType: double
		isHidden
		formatString: #,##0.0
		lineageTag: 277ec12a-a14b-4021-baf1-21d38ed8abec
		summarizeBy: none
		sourceColumn: Typical Weekday Pizzas

	/// (Revenue - typical) / standard deviation of the same weekday, excluding this date.
	column 'Revenue Z-Score'
		dataType: double
		isHidden
		formatString: 0.00
		lineageTag: e2054b3f-90e2-4e42-a6af-76c3c5dc7fd5
		summarizeBy: none
		sourceColumn: Revenue Z-Score

	column 'Orders Z-Score'
		dataType: double
		isHidden
		formatString: 0.00
		lineageTag: 4a3ea05d-bb4d-4643-b057-ae6df24ee243
		summarizeBy: none
		sourceColumn: Orders Z-Score

	/// High/Low revenue when |revenue z| >= 2, else High/Low orders when |orders z| >= 2, else Normal. Closed = no orders.
	column 'Anomaly Type'
		dataType: string
		lineageTag: d64bb0e6-ea75-49a3-b866-c324cc9a6c65
		summarizeBy: none
		sourceColumn: Anomaly Type
		sortByColumn: 'Anomaly Sort'

	/// At least one order recorded.
	column 'Is Trading Day'
		dataType: boolean
		lineageTag: b7f1ee92-febc-4729-854e-0b383da016dc
		summarizeBy: none
		sourceColumn: Is Trading Day

	column 'Anomaly Sort'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: feeea819-4ad5-491c-a73d-ea9ce95afde9
		summarizeBy: none
		sourceColumn: Anomaly Sort

	/// Public holiday or notable U.S. retail date (2015 calendar, used as context for anomalies).
	column 'Calendar Event'
		dataType: string
		lineageTag: d06ae9a7-dfe9-48ce-be2a-4fa5642c5c04
		summarizeBy: none
		sourceColumn: Calendar Event

	partition Date = m
		mode: import
		source =
				let
				    SalesYears = List.Buffer(List.Transform(List.Distinct(#"Raw Sales"[Order Date]), Date.Year)),
				    StartDate = #date(List.Min(SalesYears), 1, 1),
				    EndDate = #date(List.Max(SalesYears), 12, 31),
				    Dates = List.Dates(StartDate, Duration.Days(EndDate - StartDate) + 1, #duration(1, 0, 0, 0)),
				    #"Converted to Table" = Table.FromList(Dates, Splitter.SplitByNothing(), type table [Date = date]),
				    #"Added Year" = Table.AddColumn(#"Converted to Table", "Year", each Date.Year([Date]), Int64.Type),
				    #"Added Quarter" = Table.AddColumn(#"Added Year", "Quarter", each "Q" & Text.From(Date.QuarterOfYear([Date])), type text),
				    #"Added Month Number" = Table.AddColumn(#"Added Quarter", "Month Number", each Date.Month([Date]), Int64.Type),
				    #"Added Month" = Table.AddColumn(#"Added Month Number", "Month", each Date.ToText([Date], "MMM", "en-US"), type text),
				    #"Added Month Name" = Table.AddColumn(#"Added Month", "Month Name", each Date.ToText([Date], "MMMM", "en-US"), type text),
				    #"Added Month Year" = Table.AddColumn(#"Added Month Name", "Month Year", each Date.ToText([Date], "MMM yyyy", "en-US"), type text),
				    #"Added Month Index" = Table.AddColumn(#"Added Month Year", "Month Index", each [Year] * 12 + [Month Number], Int64.Type),
				    #"Added Week Start" = Table.AddColumn(#"Added Month Index", "Week Start", each Date.StartOfWeek([Date], Day.Monday), type date),
				    #"Added Day of Week Number" = Table.AddColumn(#"Added Week Start", "Day of Week Number", each Date.DayOfWeek([Date], Day.Monday) + 1, Int64.Type),
				    #"Added Weekday" = Table.AddColumn(#"Added Day of Week Number", "Weekday", each Date.ToText([Date], "ddd", "en-US"), type text),
				    #"Added Weekday Name" = Table.AddColumn(#"Added Weekday", "Weekday Name", each Date.ToText([Date], "dddd", "en-US"), type text),
				    #"Added Day Type" = Table.AddColumn(#"Added Weekday Name", "Day Type", each if [Day of Week Number] >= 6 then "Weekend" else "Weekday", type text),
				    #"Merged Daily Trading" = Table.NestedJoin(#"Added Day Type", {"Date"}, #"Daily Trading", {"Order Date"}, "Daily", JoinKind.LeftOuter),
				    #"Expanded Daily Trading" = Table.ExpandTableColumn(#"Merged Daily Trading", "Daily", {"Typical Weekday Revenue", "Typical Weekday Orders", "Typical Weekday Pizzas", "Revenue Z-Score", "Orders Z-Score", "Anomaly Type"}),
				    #"Added Trading Flag" = Table.AddColumn(#"Expanded Daily Trading", "Is Trading Day", each [Anomaly Type] <> null, type logical),
				    #"Replaced Closed Days" = Table.ReplaceValue(#"Added Trading Flag", null, "Closed", Replacer.ReplaceValue, {"Anomaly Type"}),
				    #"Added Anomaly Sort" = Table.AddColumn(#"Replaced Closed Days", "Anomaly Sort", each List.PositionOf({"High revenue", "Low revenue", "High orders", "Low orders", "Normal", "Closed"}, [Anomaly Type]) + 1, Int64.Type),
				    Events = #table(type table [Date = date, #"Calendar Event" = text], {{#date(2015, 1, 1), "New Year's Day"}, {#date(2015, 1, 19), "Martin Luther King Jr. Day"}, {#date(2015, 2, 1), "Super Bowl Sunday"}, {#date(2015, 2, 14), "Valentine's Day"}, {#date(2015, 2, 16), "Presidents' Day"}, {#date(2015, 3, 17), "St. Patrick's Day"}, {#date(2015, 4, 5), "Easter Sunday"}, {#date(2015, 5, 10), "Mother's Day"}, {#date(2015, 5, 25), "Memorial Day"}, {#date(2015, 6, 21), "Father's Day"}, {#date(2015, 7, 4), "Independence Day"}, {#date(2015, 9, 7), "Labor Day"}, {#date(2015, 10, 12), "Columbus Day"}, {#date(2015, 10, 31), "Halloween"}, {#date(2015, 11, 11), "Veterans Day"}, {#date(2015, 11, 26), "Thanksgiving"}, {#date(2015, 11, 27), "Black Friday"}, {#date(2015, 12, 24), "Christmas Eve"}, {#date(2015, 12, 25), "Christmas Day"}, {#date(2015, 12, 31), "New Year's Eve"}}),
				    #"Merged Calendar Events" = Table.NestedJoin(#"Added Anomaly Sort", {"Date"}, Events, {"Date"}, "Event", JoinKind.LeftOuter),
				    #"Expanded Calendar Event" = Table.ExpandTableColumn(#"Merged Calendar Events", "Event", {"Calendar Event"}),
				    #"Replaced Empty Events" = Table.ReplaceValue(#"Expanded Calendar Event", null, "", Replacer.ReplaceValue, {"Calendar Event"}),
				    #"Changed Types" = Table.TransformColumnTypes(#"Replaced Empty Events", {{"Typical Weekday Revenue", Currency.Type}, {"Typical Weekday Orders", type number}, {"Typical Weekday Pizzas", type number}, {"Revenue Z-Score", type number}, {"Orders Z-Score", type number}, {"Anomaly Type", type text}, {"Calendar Event", type text}})
				in
				    #"Changed Types"

	annotation PBI_ResultType = Table

