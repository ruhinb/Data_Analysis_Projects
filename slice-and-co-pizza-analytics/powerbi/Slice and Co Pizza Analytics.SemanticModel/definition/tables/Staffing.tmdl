/// Fact: one row per trading day x half-hour (9:30 AM - 11:00 PM). Demand comes from Sales; recommended roster follows the rules in docs/methodology.md.
table Staffing
	lineageTag: a00a6191-08b0-42ae-90da-5eafb1efcf65

	/// Foreign key to Date.
	column Date
		dataType: dateTime
		isHidden
		formatString: dd mmm yyyy
		lineageTag: a2ccf19c-0a2c-48e5-a9e0-3fe826f11036
		summarizeBy: none
		sourceColumn: Date

		annotation UnderlyingDateTimeDataType = Date

	/// Foreign key to Time Slot.
	column 'Slot Key'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 542f888e-7862-4adb-ab3b-889390457285
		summarizeBy: none
		sourceColumn: Slot Key

	/// Orders in the half-hour: No orders, Low (1-2), Moderate (3-4), High (5+).
	column 'Demand Band'
		dataType: string
		lineageTag: 8445c939-f490-4ed4-b609-05982a5ed34e
		summarizeBy: none
		sourceColumn: Demand Band
		sortByColumn: 'Demand Band Sort'

	column 'Demand Band Sort'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 1c3e00de-a251-43bf-a9f7-ce3a8f325eb1
		summarizeBy: none
		sourceColumn: Demand Band Sort

	column 'Slot Orders'
		dataType: int64
		isHidden
		formatString: #,##0
		lineageTag: a8725c47-de47-4248-8734-cf02cac5da02
		summarizeBy: sum
		sourceColumn: Slot Orders

	column 'Slot Pizzas'
		dataType: int64
