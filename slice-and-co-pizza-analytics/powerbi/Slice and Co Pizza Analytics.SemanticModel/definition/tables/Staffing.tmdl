	/// Scheduled minus recommended people.
	column 'Staffing Gap'
		dataType: int64
		isHidden
		formatString: +0;-0;0
		lineageTag: 8d3e4a1e-61fd-4503-85fa-3db769fa4932
		summarizeBy: none
		sourceColumn: Staffing Gap

	partition Staffing = m
		mode: import
		source =
				let
				    Source = #"Raw Roster",
				    SlotDemand = Table.Group(#"Order Header", {"Order Date", "Slot Key"}, {{"Slot Orders", each Table.RowCount(_), Int64.Type}, {"Slot Pizzas", each List.Sum([Order Pizzas]), Int64.Type}, {"Slot Revenue", each List.Sum([Order Revenue]), Currency.Type}}),
				    #"Merged Slot Demand" = Table.NestedJoin(Source, {"Date", "Slot Key"}, SlotDemand, {"Order Date", "Slot Key"}, "Demand", JoinKind.LeftOuter),
				    #"Expanded Slot Demand" = Table.ExpandTableColumn(#"Merged Slot Demand", "Demand", {"Slot Orders", "Slot Pizzas", "Slot Revenue"}),
				    #"Replaced Empty Demand" = Table.ReplaceValue(#"Expanded Slot Demand", null, 0, Replacer.ReplaceValue, {"Slot Orders", "Slot Pizzas", "Slot Revenue"}),
				    #"Added Demand Band" = Table.AddColumn(#"Replaced Empty Demand", "Demand Band", each if [Slot Orders] = 0 then "No orders" else if [Slot Orders] <= 2 then "Low" else if [Slot Orders] <= 4 then "Moderate" else "High", type text),
				    #"Added Demand Band Sort" = Table.AddColumn(#"Added Demand Band", "Demand Band Sort", each List.PositionOf({"No orders", "Low", "Moderate", "High"}, [Demand Band]) + 1, Int64.Type),
				    #"Added Recommended Kitchen" = Table.AddColumn(#"Added Demand Band Sort", "Recommended Kitchen", each List.Max({1, Number.RoundUp([Slot Pizzas] * DemandBuffer / PizzasPerCookPerSlot)}), Int64.Type),
				    #"Added Recommended Service" = Table.AddColumn(#"Added Recommended Kitchen", "Recommended Service", each List.Max({1, Number.RoundUp([Slot Orders] * DemandBuffer / OrdersPerServerPerSlot)}), Int64.Type),
				    #"Added Recommended Prep" = Table.AddColumn(#"Added Recommended Service", "Recommended Prep", each if [Slot Key] >= 570 and [Slot Key] < 1050 then 1 else 0, Int64.Type),
				    #"Added Recommended Staff" = Table.AddColumn(#"Added Recommended Prep", "Recommended Staff", each 1 + [Recommended Kitchen] + [Recommended Service] + [Recommended Prep], Int64.Type),
				    #"Added Recommended Labour Hours" = Table.AddColumn(#"Added Recommended Staff", "Recommended Labour Hours", each [Recommended Staff] * 0.5, type number),
				    #"Added Recommended Labour Cost" = Table.AddColumn(#"Added Recommended Labour Hours", "Recommended Labour Cost", each 0.5 * (16.02 + [Recommended Kitchen] * 11.74 + [Recommended Service] * 9.47 + [Recommended Prep] * 9.79), Currency.Type),
				    #"Added Staffing Gap" = Table.AddColumn(#"Added Recommended Labour Cost", "Staffing Gap", each [Scheduled Staff] - [Recommended Staff], Int64.Type),
				    #"Removed Redundant Attributes" = Table.SelectColumns(#"Added Staffing Gap", {"Date", "Slot Key", "Demand Band", "Demand Band Sort", "Slot Orders", "Slot Pizzas", "Slot Revenue", "Shift Managers", "Kitchen Crew", "Service Crew", "Prep Utility", "Scheduled Staff", "Scheduled Labour Hours", "Scheduled Labour Cost", "Recommended Kitchen", "Recommended Service", "Recommended Prep", "Recommended Staff", "Recommended Labour Hours", "Recommended Labour Cost", "Staffing Gap"}),
				    #"Changed Types" = Table.TransformColumnTypes(#"Removed Redundant Attributes", {{"Slot Orders", Int64.Type}, {"Slot Pizzas", Int64.Type}, {"Slot Revenue", Currency.Type}})
				in
				    #"Changed Types"

