/// Raw transaction file, typed and cleaned. Not loaded.
expression 'Raw Sales' =
		let
		    ExternalFile = if Text.Length(Text.Trim(SalesFilePath)) > 0 then try File.Contents(SalesFilePath) otherwise null else null,
		    EmbeddedFile = Binary.Decompress(Binary.FromText(#"Embedded Sales CSV", BinaryEncoding.Base64), Compression.GZip),
		    Source = Csv.Document(if ExternalFile <> null then ExternalFile else EmbeddedFile, [Delimiter = ",", Columns = 10, Encoding = 1252, QuoteStyle = QuoteStyle.Csv]),
		    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
		    #"Renamed Columns" = Table.RenameColumns(#"Promoted Headers", {{"order_id", "Order ID"}, {"date", "Order Date"}, {"time", "Order Time"}, {"pizza_id", "Pizza ID"}, {"quantity", "Quantity"}, {"size", "Size"}, {"price", "Unit Price"}, {"name", "Pizza Name"}, {"category", "Category"}, {"ingredients", "Ingredients"}}),
		    #"Trimmed Text" = Table.TransformColumns(#"Renamed Columns", {{"Pizza ID", Text.Trim, type text}, {"Size", Text.Trim, type text}, {"Pizza Name", Text.Trim, type text}, {"Category", Text.Trim, type text}, {"Ingredients", Text.Trim, type text}}),
		    #"Parsed Order Date" = Table.TransformColumns(#"Trimmed Text", {{"Order Date", each Date.FromText(Text.AfterDelimiter(_, ", "), [Culture = "en-US"]), type date}}),
		    #"Parsed Order Time" = Table.TransformColumns(#"Parsed Order Date", {{"Order Time", each Time.FromText(_, [Culture = "en-US"]), type time}}),
		    #"Changed Types" = Table.TransformColumnTypes(#"Parsed Order Time", {{"Order ID", Int64.Type}, {"Quantity", Int64.Type}, {"Unit Price", Currency.Type}}, "en-US"),
		    #"Added Slot Key" = Table.AddColumn(#"Changed Types", "Slot Key", each Time.Hour([Order Time]) * 60 + (if Time.Minute([Order Time]) >= 30 then 30 else 0), Int64.Type),
		    #"Added Line Revenue" = Table.AddColumn(#"Added Slot Key", "Line Revenue", each [Quantity] * [Unit Price], Currency.Type)
		in
		    #"Added Line Revenue"
	lineageTag: 364179af-5279-4c3f-88e5-60ba1f0861e4

/// Baseline roster, typed. Not loaded.
expression 'Raw Roster' =
		let
		    ExternalFile = if Text.Length(Text.Trim(RosterFilePath)) > 0 then try File.Contents(RosterFilePath) otherwise null else null,
		    EmbeddedFile = Binary.Decompress(Binary.FromText(#"Embedded Roster CSV", BinaryEncoding.Base64), Compression.GZip),
		    Source = Csv.Document(if ExternalFile <> null then ExternalFile else EmbeddedFile, [Delimiter = ",", Columns = 9, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
		    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
		    #"Changed Types" = Table.TransformColumnTypes(#"Promoted Headers", {{"Date", type date}, {"Slot Start", type time}, {"Shift Managers", Int64.Type}, {"Kitchen Crew", Int64.Type}, {"Service Crew", Int64.Type}, {"Prep Utility", Int64.Type}, {"Scheduled Staff", Int64.Type}, {"Scheduled Labour Hours", type number}, {"Scheduled Labour Cost", Currency.Type}}, "en-US"),
		    #"Added Slot Key" = Table.AddColumn(#"Changed Types", "Slot Key", each Time.Hour([Slot Start]) * 60 + Time.Minute([Slot Start]), Int64.Type)
		in
		    #"Added Slot Key"
	lineageTag: 7f171d1d-f193-4b8d-b0d1-2d450283ad0d

/// One row per order with timing attributes. Not loaded; feeds Orders, Sales and Staffing.
expression 'Order Header' =
		let
		    Source = #"Raw Sales",
		    #"Grouped by Order" = Table.Group(Source, {"Order ID", "Order Date", "Order Time", "Slot Key"}, {{"Order Lines", each Table.RowCount(_), Int64.Type}, {"Order Pizzas", each List.Sum([Quantity]), Int64.Type}, {"Order Revenue", each List.Sum([Line Revenue]), Currency.Type}}),
		    #"Sorted Chronologically" = Table.Buffer(Table.Sort(#"Grouped by Order", {{"Order Date", Order.Ascending}, {"Order Time", Order.Ascending}, {"Order ID", Order.Ascending}})),
		    PreviousDates = {null} & List.RemoveLastN(#"Sorted Chronologically"[Order Date], 1),
		    PreviousTimes = {null} & List.RemoveLastN(#"Sorted Chronologically"[Order Time], 1),
		    #"Added Previous Order" = Table.FromColumns(Table.ToColumns(#"Sorted Chronologically") & {PreviousDates, PreviousTimes}, Table.ColumnNames(#"Sorted Chronologically") & {"Previous Order Date", "Previous Order Time"}),
		    #"Restored Types" = Table.TransformColumnTypes(#"Added Previous Order", {{"Order ID", Int64.Type}, {"Order Date", type date}, {"Order Time", type time}, {"Slot Key", Int64.Type}, {"Order Lines", Int64.Type}, {"Order Pizzas", Int64.Type}, {"Order Revenue", Currency.Type}, {"Previous Order Date", type date}, {"Previous Order Time", type time}}),
		    #"Added Minutes Since Previous Order" = Table.AddColumn(#"Restored Types", "Minutes Since Previous Order", each if [Previous Order Date] = [Order Date] then Duration.TotalMinutes([Order Time] - [Previous Order Time]) else null, type number),
		    #"Added Order Type" = Table.AddColumn(#"Added Minutes Since Previous Order", "Order Type", each if [Order Pizzas] = 1 then "Single pizza" else "Multiple pizzas", type text),
		    #"Removed Helper Columns" = Table.RemoveColumns(#"Added Order Type", {"Previous Order Date", "Previous Order Time"})
		in
		    #"Removed Helper Columns"
	lineageTag: 43e6c28b-715d-4478-a6d5-3f2fc5f59282

/// Daily totals with weekday-adjusted baselines and anomaly flags. Not loaded; merged into Date.
expression 'Daily Trading' =
		let
		    Source = #"Order Header",
		    #"Grouped by Day" = Table.Group(Source, {"Order Date"}, {{"Revenue", each List.Sum([Order Revenue]), type number}, {"Orders", each Table.RowCount(_), type number}, {"Pizzas", each List.Sum([Order Pizzas]), type number}}),
		    #"Added Weekday" = Table.AddColumn(#"Grouped by Day", "Day of Week Number", each Date.DayOfWeek([Order Date], Day.Monday) + 1, Int64.Type),
		    #"Weekday Statistics" = Table.Group(#"Added Weekday", {"Day of Week Number"}, {{"Days", each Table.RowCount(_), type number}, {"Revenue Sum", each List.Sum([Revenue]), type number}, {"Revenue Sum Sq", each List.Sum(List.Transform([Revenue], each _ * _)), type number}, {"Orders Sum", each List.Sum([Orders]), type number}, {"Orders Sum Sq", each List.Sum(List.Transform([Orders], each _ * _)), type number}, {"Pizzas Sum", each List.Sum([Pizzas]), type number}}),
		    #"Merged Weekday Statistics" = Table.NestedJoin(#"Added Weekday", {"Day of Week Number"}, #"Weekday Statistics", {"Day of Week Number"}, "Stats", JoinKind.LeftOuter),
		    #"Expanded Statistics" = Table.ExpandTableColumn(#"Merged Weekday Statistics", "Stats", {"Days", "Revenue Sum", "Revenue Sum Sq", "Orders Sum", "Orders Sum Sq", "Pizzas Sum"}),
		    #"Added Typical Revenue" = Table.AddColumn(#"Expanded Statistics", "Typical Weekday Revenue", each ([Revenue Sum] - [Revenue]) / ([Days] - 1), type number),
		    #"Added Typical Orders" = Table.AddColumn(#"Added Typical Revenue", "Typical Weekday Orders", each ([Orders Sum] - [Orders]) / ([Days] - 1), type number),
		    #"Added Typical Pizzas" = Table.AddColumn(#"Added Typical Orders", "Typical Weekday Pizzas", each ([Pizzas Sum] - [Pizzas]) / ([Days] - 1), type number),
		    #"Added Revenue Z-Score" = Table.AddColumn(#"Added Typical Pizzas", "Revenue Z-Score", each ([Revenue] - [Typical Weekday Revenue]) / Number.Sqrt(([Revenue Sum Sq] - [Revenue] * [Revenue] - ([Days] - 1) * [Typical Weekday Revenue] * [Typical Weekday Revenue]) / ([Days] - 2)), type number),
		    #"Added Orders Z-Score" = Table.AddColumn(#"Added Revenue Z-Score", "Orders Z-Score", each ([Orders] - [Typical Weekday Orders]) / Number.Sqrt(([Orders Sum Sq] - [Orders] * [Orders] - ([Days] - 1) * [Typical Weekday Orders] * [Typical Weekday Orders]) / ([Days] - 2)), type number),
		    #"Added Anomaly Type" = Table.AddColumn(#"Added Orders Z-Score", "Anomaly Type", each if Number.Abs([#"Revenue Z-Score"]) >= AnomalyThreshold then (if [#"Revenue Z-Score"] > 0 then "High revenue" else "Low revenue") else if Number.Abs([#"Orders Z-Score"]) >= AnomalyThreshold then (if [#"Orders Z-Score"] > 0 then "High orders" else "Low orders") else "Normal", type text),
		    #"Selected Columns" = Table.SelectColumns(#"Added Anomaly Type", {"Order Date", "Typical Weekday Revenue", "Typical Weekday Orders", "Typical Weekday Pizzas", "Revenue Z-Score", "Orders Z-Score", "Anomaly Type"})
		in
		    #"Selected Columns"
	lineageTag: 1fab22c1-72f7-4014-bce1-a0998303ea11

/// Distinct menu items with surrogate keys. Not loaded; feeds Pizza, Ingredient and the bridge.
expression 'Pizza Staging' =
		let
		    Source = Table.SelectColumns(#"Raw Sales", {"Pizza ID", "Pizza Name", "Category", "Size", "Unit Price", "Ingredients"}),
		    #"Removed Duplicates" = Table.Distinct(Source),
		    #"Renamed Menu Price" = Table.RenameColumns(#"Removed Duplicates", {{"Unit Price", "Menu Price"}}),
		    #"Added Pizza Type" = Table.AddColumn(#"Renamed Menu Price", "Pizza Type", each Text.BeforeDelimiter([Pizza ID], "_", {0, RelativePosition.FromEnd}), type text),
		    #"Added Short Name" = Table.AddColumn(#"Added Pizza Type", "Short Name", each let withoutThe = if Text.StartsWith([Pizza Name], "The ") then Text.Middle([Pizza Name], 4) else [Pizza Name] in if Text.EndsWith(withoutThe, " Pizza") then Text.Start(withoutThe, Text.Length(withoutThe) - 6) else withoutThe, type text),
		    #"Added Size Sort" = Table.AddColumn(#"Added Short Name", "Size Sort", each List.PositionOf({"S", "M", "L", "XL", "XXL"}, [Size]) + 1, Int64.Type),
		    #"Added Size Name" = Table.AddColumn(#"Added Size Sort", "Size Name", each {"Small", "Medium", "Large", "X-Large", "XX-Large"}{[Size Sort] - 1}, type text),
		    #"Added Category Sort" = Table.AddColumn(#"Added Size Name", "Category Sort", each List.PositionOf({"Classic", "Supreme", "Chicken", "Veggie"}, [Category]) + 1, Int64.Type),
		    #"Sorted Rows" = Table.Sort(#"Added Category Sort", {{"Category", Order.Ascending}, {"Pizza Name", Order.Ascending}, {"Size Sort", Order.Ascending}}),
		    #"Added Pizza Key" = Table.AddIndexColumn(#"Sorted Rows", "Pizza Key", 1, 1, Int64.Type)
		in
		    #"Added Pizza Key"
	lineageTag: c2fec58c-f5c7-4b86-9a8d-911335baf413

